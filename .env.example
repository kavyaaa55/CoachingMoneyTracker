# Postgres connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/fee_tracker

# Fixes "today" for the demo. Leave empty to use the real date in India.
APP_TODAY=2026-11-02

# Signs session cookies and OTP hashes. At least 32 characters.
SESSION_SECRET=

# Shows the OTP on screen instead of sending an SMS. Never enable with real users.
DEMO_MODE=true

# Signs webhooks from the mock payment gateway. At least 32 characters.
GATEWAY_WEBHOOK_SECRET=

# Public address of this app.
APP_URL=http://localhost:3000

# Optional. Drafts call briefs and reads payer notes. Without it, plain templates and rules are used.
GEMINI_API_KEY=

# Protects the scheduled reminders and risk routes. At least 32 characters.
CRON_SECRET=
