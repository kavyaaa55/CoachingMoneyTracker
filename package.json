{
  "name": "fee-tracker",
  "version": "1.0.0",
  "description": "Fee portal for a coaching institute: dues, reminders, refunds and an AI dropout flag, in Hindi and English.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Siddhesh-source/coaching_institute.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "test:load": "tsx --env-file-if-exists=.env --tsconfig tsconfig.json scripts/load-test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:db"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.5",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
